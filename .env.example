NODE_ENV=development
PORT=8000

# MongoDB — replica set is required for multi-document transactions.
# directConnection=true connects straight to the primary without topology discovery.
MONGO_URI=mongodb://localhost:27017/mini-erp?directConnection=true

# JWT
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Image upload (local storage for now; swap to S3/Cloudinary later)
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Seed script (only needed when running `pnpm seed`)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
